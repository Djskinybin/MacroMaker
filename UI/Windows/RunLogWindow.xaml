<Window x:Class="MacroMaker.RunLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Run Log" Width="780" Height="540" MinWidth="440" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Run Log" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock x:Name="SummaryText" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <ListBox x:Name="EntriesList" Grid.Row="1"
                 AutomationProperties.Name="Run log entries"
                 Background="{DynamicResource Panel2Brush}"
                 BorderBrush="{DynamicResource BorderBrushSoft}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="EntriesList_SelectionChanged"
                 MouseDoubleClick="EntriesList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid TextElement.Foreground="{DynamicResource TextBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}" Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock x:Name="LevelText" Grid.Column="1" Text="{Binding Level}" FontWeight="SemiBold"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="StepLabel" Text="{Binding StepLabel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="MessageText" Text="{Binding Message}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Step}" Value="{x:Null}">
                            <Setter TargetName="StepLabel" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="Step">
                            <Setter TargetName="MessageText" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="Error">
                            <Setter TargetName="LevelText" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="GoToButton" Content="Go to Step" IsDefault="True" IsEnabled="False" Click="GoToButton_Click"/>
            <Button Content="Close" IsCancel="True" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
